# ---------------------------------------------------------------
# みる陸 ローカル開発用の環境変数サンプル
#   cp .env.example .env
# .env は Git に含めません。本番では環境変数として注入してください。
# ---------------------------------------------------------------

# PostgreSQL 接続文字列（docker compose の既定値）
DATABASE_URL="postgresql://miruriku:miruriku@localhost:5432/miruriku?schema=public"

# DB 統合テスト（pnpm test:db）用。開発用 DB とは別のデータベースを使います。
TEST_DATABASE_URL="postgresql://miruriku:miruriku@localhost:5432/miruriku_test?schema=public"

# E2E テスト（pnpm test:e2e）用。テスト開始時に初期化されます。
E2E_DATABASE_URL="postgresql://miruriku:miruriku@localhost:5432/miruriku_e2e?schema=public"

# ローカル管理画面（/admin）を有効にするには "true" を明示してください（既定は無効）。
# NODE_ENV=production（next build / next start / 本番コンテナ）では
# この値に関わらず管理画面・管理用の書き込みはすべて拒否されます。
# 公開運用の前には、別途管理者認証・認可の実装が必要です。
MIRURIKU_ADMIN_ENABLED="false"

# 収集 CLI が送る User-Agent（連絡先を含めることを推奨）
COLLECTOR_USER_AGENT="mirurikuBot/0.1 (+https://example.com/miruriku-bot; local development)"

# （開発・テスト専用）現在時刻の固定。例: 2026-10-10T12:00:00+09:00
# NODE_ENV=production では無視されます。通常は空のままにしてください。
MIRURIKU_FIXED_NOW=""

# 公開サイトの URL（canonical・OGP・サイトマップの絶対 URL に使う）。
# 本番ではデプロイ時に DOMAIN から自動で設定されます。ローカルでは空のままで構いません
# （空なら絶対 URL を出さず、sitemap.xml も空になります）。
MIRURIKU_SITE_URL=""
