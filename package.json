{
  "name": "miruriku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "MIRURIKU_INCLUDE_DEV_ROUTES=1 NEXT_DIST_DIR=.next next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project ui",
    "test:watch": "vitest --project unit --project ui",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "collect": "tsx scripts/collect.ts",
    "data:load": "tsx scripts/load-real-events.ts",
    "setup": "pnpm db:up && pnpm db:deploy && pnpm db:seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "29.1.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
