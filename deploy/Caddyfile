# みる陸 本番用の Caddy 設定（HTTPS 終端・リバースプロキシ）。
# 証明書は Let's Encrypt から自動で取得・更新する（80/443 番ポートの公開が必要）。
{$DOMAIN} {
	encode zstd gzip

	# 管理画面は本番では常に無効（アプリ側でも 404）。念のためプロキシでも遮断する
	@admin path /admin /admin/*
	respond @admin "Not Found" 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy web:3000 {
		# Suspense のストリーミングをバッファリングせずにすぐ送る
		flush_interval -1
	}
}

# www 付きの名前と、以前の URL（sslip.io）は公開ドメインへ恒久的に転送する（証明書も自動取得）。
# パスとクエリは引き継ぐ。値は deploy.sh が DNS を確認して決める（deploy/lib.sh の redirect_domains）
{$REDIRECT_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}

# IP アドレスなど、ほかの名前で HTTP アクセスされた場合はドメインの HTTPS へ転送する
http:// {
	redir https://{$DOMAIN}{uri} permanent
}
