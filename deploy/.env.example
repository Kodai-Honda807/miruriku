# ---------------------------------------------------------------
# みる陸 AWS（Lightsail）デプロイ設定のサンプル
#   cp deploy/.env.example deploy/.env
# deploy/.env は Git に含めません（.gitignore の .env* で除外済み）。
# 使い方は docs/deploy.md を参照してください。
# ---------------------------------------------------------------

# --- AWS の認証 ---------------------------------------------------
# 推奨: アクセスキーをこのファイルに書かず、AWS CLI のプロファイルを使う。
#   aws configure sso --profile miruriku     （IAM Identity Center を使う場合）
#   aws configure --profile miruriku         （IAM ユーザーのアクセスキーを使う場合）
# 必要な権限は deploy/iam-policy.json を参照。
AWS_PROFILE="miruriku"
AWS_REGION="ap-northeast-1"

# どうしてもプロファイルを使えない場合だけ、アクセスキーを直接書く（非推奨。漏えいに注意）
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# --- Lightsail のリソース名・プラン ---------------------------------
LIGHTSAIL_INSTANCE_NAME="miruriku"
LIGHTSAIL_AVAILABILITY_ZONE="ap-northeast-1a"
# small_3_0 = 2GB メモリ / 60GB SSD / 月 12 USD（サーバー上で next build するため 2GB 以上を推奨）
LIGHTSAIL_BUNDLE_ID="small_3_0"
# 空なら Ubuntu 24.04 の最新ブループリントを自動で選ぶ
LIGHTSAIL_BLUEPRINT_ID=""
LIGHTSAIL_STATIC_IP_NAME="miruriku-ip"
LIGHTSAIL_KEY_PAIR_NAME="miruriku-key"

# リソースに付けるタグ（「キー=値」を空白区切り）。AWS アカウント内の他のアプリと区別するために使う。
# Lightsail でタグを付けられるのはインスタンスと SSH 鍵だけ（静的 IP は非対応、自動スナップショットは引き継がない）。
# 使える文字: 英数字と + - = . _ : / @（キー・値に空白は不可。aws: で始まるキーは不可）
RESOURCE_TAGS="project=miruriku environment=production managed-by=miruriku-deploy"

# 自動スナップショット（毎日・7 世代。保存容量に応じて 0.05 USD/GB月 がかかる）
ENABLE_AUTO_SNAPSHOT="true"
# スナップショットを取る時刻（UTC、HH:00）。18:00 UTC = 日本時間 3:00
AUTO_SNAPSHOT_TIME_UTC="18:00"

# --- SSH ---------------------------------------------------------
# 秘密鍵の保存先（WSL のホーム配下。/mnt/c 配下は権限を 600 にできないため不可）
SSH_KEY_PATH="$HOME/.ssh/miruriku-lightsail"
# SSH を許可する接続元（CIDR）。空なら、実行した時点のグローバル IP（/32）だけを許可する
SSH_ALLOWED_CIDR=""

# --- 公開設定 ------------------------------------------------------
# 独自ドメインを使う場合は、DNS の A レコードを静的 IP に向けてから設定する（例: DOMAIN="miruriku.com"）。
# 以前の sslip.io の URL と www 付きの名前（DNS が向いている場合）は、このドメインへ 301 転送する。
# 空なら <IPのドットをハイフンにしたもの>.sslip.io を使う（HTTPS 証明書は Let's Encrypt で自動取得）
DOMAIN=""

# 収集 CLI が送る User-Agent（連絡先を含める）
COLLECTOR_USER_AGENT="mirurikuBot/0.1 (+https://github.com/Kodai-Honda807/miruriku)"
